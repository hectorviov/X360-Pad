// The app's connection to one controller slot (X360Settings.h has the selectors): it sends the slot's settings, reads its live state for the
// window, and tests its motors. Created by X360PadSlot::NewUserClient when the app opens the slot's service.
#ifndef X360PadUserClient_h
#define X360PadUserClient_h

#include <Availability.h>
#include <DriverKit/IOUserClient.iig>

class X360PadUserClient: public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    virtual kern_return_t ExternalMethod(uint64_t selector, IOUserClientMethodArguments * arguments, const IOUserClientMethodDispatch * dispatch,
                                         OSObject * target, void * reference) override;
};

#endif
